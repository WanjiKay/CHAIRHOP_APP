<div class="page" style="background:white; min-height:100vh; padding:2rem;">
  <header role="banner" class="app-header container"
          style="text-align:center; margin-bottom:1rem; position:relative; border-bottom:1px solid #ddd; padding-bottom:1rem;">
    <h1 style="font-size:1.8rem; font-weight:600; margin-bottom:0.5rem;">ChairHop Profile</h1>

    <% if @editing %>
      <%= link_to "Done", profile_path, class: "button button--primary",
                  style: "position:absolute; right:0; bottom:0;" %>
    <% else %>
      <%= link_to "Manage my profile", profile_path(edit: 1), class: "button button--primary",
                  style: "position:absolute; right:0; bottom:0;" %>
    <% end %>
  </header>

  <% row_style = "display:grid; grid-template-columns:200px 1fr; column-gap:1rem; row-gap:0.5rem; align-items:center;" %>

  <% if !@editing %>
    <article class="profile card" style="background:white; padding:2rem; border-radius:0.5rem; box-shadow:0 0 10px rgba(0,0,0,0.05);">
      <div class="profile__row" style="<%= row_style %>"><div class="profile__label">Name</div><div class="profile__value"><%= @user.name.presence || content_tag(:span, "Not set", class: "muted") %></div></div>
      <div class="profile__row" style="<%= row_style %>"><div class="profile__label">Location</div><div class="profile__value"><%= @user.location.presence || content_tag(:span, "Not set", class: "muted") %></div></div>
      <div class="profile__row" style="<%= row_style %>"><div class="profile__label">Username</div><div class="profile__value"><%= @user.username.presence || content_tag(:span, "Not set", class: "muted") %></div></div>
      <div class="profile__row" style="<%= row_style %>"><div class="profile__label">Password</div><div class="profile__value">••••••••</div></div>
      <div class="profile__row" style="<%= row_style %>"><div class="profile__label">About you</div><div class="profile__value"><%= @user.about.presence || content_tag(:span, "Tell others a bit about yourself.", class: "muted") %></div></div>
    </article>
  <% else %>
    <article class="profile card" style="background:white; padding:2rem; border-radius:0.5rem; box-shadow:0 0 10px rgba(0,0,0,0.05);">
      <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
        <p class="muted" id="profile-help">Fields marked with * are required.</p>
        <div class="profile__row" style="<%= row_style %>"><%= f.label :name, "Name*", class: "profile__label" %><%= f.text_field :name, class: "input profile__control", placeholder: "Jane Doe", required: true %></div>
        <div class="profile__row" style="<%= row_style %>"><%= f.label :location, "Location", class: "profile__label" %><%= f.text_field :location, class: "input profile__control", placeholder: "City, Country" %></div>
        <div class="profile__row" style="<%= row_style %>"><%= f.label :username, "Username*", class: "profile__label" %><%= f.text_field :username, class: "input profile__control", placeholder: "janedoe", required: true %></div>
        <div class="profile__row" style="<%= row_style %>"><%= f.label :password, "Password*", class: "profile__label" %><%= f.password_field :password, class: "input profile__control", placeholder: "••••••••", autocomplete: "new-password" %></div>
        <div class="profile__row" style="<%= row_style %>"><%= f.label :password_confirmation, "Confirm password", class: "profile__label" %><%= f.password_field :password_confirmation, class: "input profile__control", placeholder: "••••••••", autocomplete: "new-password" %></div>
        <div class="profile__row" style="<%= row_style.gsub('align-items:center', 'align-items:start') %>"><%= f.label :about, "About you", class: "profile__label" %><%= f.text_area :about, class: "input input--textarea profile__control", rows: 5, placeholder: "A short bio..." %></div>
        <div class="profile__edit-actions" style="display:flex; gap:0.5rem;"><%= f.submit "Save", class: "button button--primary" %> <%= link_to "Cancel", profile_path, class: "button button--ghost" %></div>
      <% end %>
    </article>
  <% end %>
</div>
