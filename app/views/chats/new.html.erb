<div class="container py-5">
  <div class="form-container">
    <%= simple_form_for [@chat] do |f| %>
      <div class="form-group">
        <%= f.input :title, placeholder: "How can I help?", required: true, label: false, input_html: {class: "form-control"} %>
      </div>
      <%= f.hidden_field :appointment_id, value: @appointment.id if @appointment.present? %>
      <%= f.submit class: "custom-btn" %>
      <% end %>
    </div>
  </div>
