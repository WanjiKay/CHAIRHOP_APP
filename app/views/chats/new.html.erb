<div class="container py-5">
  <div class="row">
    <div class="col-12 col-md-6 offset-lg-3">
      <div class="bg-blue rounded p-3 shadow">
        <%= simple_form_for [@chat] do |f| %>
          <%= f.input :title, placeholder: "How can I help?" %>
          <%= f.submit class: "btn btn-flat" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
