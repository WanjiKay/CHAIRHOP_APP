<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid header-display-desktop" data-content-field="site-title">

    <!-- Left: Logo / Site title -->
    <div class="header-title-nav-wrapper">
      <div class="header-title" data-animation-role="header-element">
        <div class="header-title-text">
          <%= link_to root_path, id: "site-title", data: { animation_role: "header-element" } do %>
            <%= image_tag "logo.png", alt: "ChairHop Logo", class: "navbar-logo" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Middle: (optional) navigation links -->
    <div class="header-nav">
      <div class="header-nav-wrapper">
        <nav class="header-nav-list">
          <!-- add your nav items here if needed -->
          <div class="header-nav-item header-nav-item--collection"></div>
          <div class="header-nav-item header-nav-item--collection"></div>
        </nav>
      </div>
    </div>

    <!-- Right: actions -->
    <div class="header-actions header-actions--right">
      <% if defined?(user_signed_in?) && user_signed_in? %>
        <!-- Signed-in UI -->
        <div class="dropdown header-actions-action">
          <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <% if defined?(current_user) && current_user %>
              <%= image_tag(
                    (current_user.respond_to?(:avatar) && current_user.avatar&.attached?) ? url_for(current_user.avatar) : "https://kitt.lewagon.com/placeholder/users/#{current_user.id}",
                    class: "avatar",
                    alt: "User menu"
                  ) %>
            <% else %>
              <span class="avatar">👤</span>
            <% end %>
          </a>
          <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <% if defined?(edit_user_registration_path) %>
              <%= link_to "Profile", edit_user_registration_path, class: "dropdown-item" %>
              <%= link_to "Settings", edit_user_registration_path, class: "dropdown-item" %>
            <% end %>
            <% if defined?(destroy_user_session_path) %>
              <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
            <% end %>
          </div>
        </div>
      <% else %>
        <!-- Guest UI -->
        <div class="header-actions-action header-actions-action--cta" data-animation-role="header-element">
          <%= link_to "My Profile", (defined?(profile_path) ? profile_path : root_path), class: "button button--ghost" %>
        </div>
        <% if defined?(new_user_session_path) %>
          <div class="header-actions-action header-actions-action--cta" data-animation-role="header-element">
            <%= link_to "Login", new_user_session_path, class: "btn btn--border theme-btn--primary-inverse" %>
          </div>
        <% end %>
      <% end %>
    </div>

  </div>
</nav>

<style>
  .navbar-logo { height: 40px; width: auto; }
</style>
